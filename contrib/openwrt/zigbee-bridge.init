#!/bin/sh /etc/rc.common
# zigbee-bridge on OpenWrt (procd).
#
#   cp zigbee-bridge.init /etc/init.d/zigbee-bridge
#   chmod +x /etc/init.d/zigbee-bridge
#   /etc/init.d/zigbee-bridge enable
#   /etc/init.d/zigbee-bridge start
#
# /var is in RAM on OpenWrt: set [data] dir to a directory on flash, such as
# /etc/zigbee-bridge/data, or the network keys are lost at reboot.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/zigbee-bridge
CONFIG=/etc/zigbee-bridge/config.toml

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG"
	procd_set_param env RUST_LOG=info
	procd_set_param file "$CONFIG"
	# Restart forever, 5 s apart: exit status 75 (after a restore) included.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
